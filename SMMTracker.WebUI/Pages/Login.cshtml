@page
@model SMMTracker.WebUI.ViewModels.LoginModel
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "Вход";
    Layout = "_Layout";
}

@if (Model.IsAuthenticated)
{
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="glass-card text-center">
                    <h2 class="mb-4">Вы уже авторизованы</h2>
                    <p class="mb-4">Вы вошли как: @User.Identity?.Name</p>
                    <div class="d-grid gap-3">
                        <a href="/Dashboard" class="btn btn-primary btn-lg">
                            <i class="bi bi-speedometer2 me-2"></i>Перейти в Dashboard
                        </a>
                        <form method="post" class="d-inline">
                            <button type="submit" asp-page-handler="ForceLogout" class="btn btn-outline-danger btn-lg">
                                <i class="bi bi-box-arrow-right me-2"></i>Выйти
                            </button>
                        </form>
                        <div class="mt-3">
                            <small class="text-muted">Если это не вы, нажмите "Принудительный выход"</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="glass-card">
                    <div class="text-center mb-4">
                        <h2 class="mb-3">
                            <i class="bi bi-telegram text-primary"></i>
                            <br />
                            Telegram Авторизация
                        </h2>
                        <p class="text-muted">Войдите с помощью вашего Telegram аккаунта</p>
                    </div>
                    
                    <!-- Telegram Login Widget -->
                    <div class="text-center mb-4">
                        <script async src="https://telegram.org/js/telegram-widget.js?22" 
                                data-telegram-login="SmmTrackerTestBot_bot"
                                data-size="large" 
                                data-auth-url="https://smmtracker.ru/api/auth/telegram-callback"
                                data-request-access="write"
                                data-userpic="true">
                        </script>
                    </div>
                    
                    <div class="text-center mb-3">
                        <p class="text-muted small">
                            Нажмите кнопку выше, чтобы авторизоваться через Telegram
                        </p>
                    </div>
                    
                    <div class="text-center">
                        <a href="/" class="btn btn-link">
                            <i class="bi bi-arrow-left me-1"></i>Назад на главную
                        </a>
                    </div>
                    
                    <!-- Сообщение об ошибке -->
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-warning mt-3" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            @Model.ErrorMessage
                        </div>
                    }
                    
                    <!-- Тестовая кнопка для разработки -->
                    <div class="mt-4 pt-3 border-top">
                        <div class="text-center">
                            <p class="text-muted small mb-2">Для тестирования без Telegram:</p>
                            <a href="/Dashboard" class="btn btn-success btn-lg">
                                <i class="bi bi-rocket-takeoff me-2"></i>Тестовый вход
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}