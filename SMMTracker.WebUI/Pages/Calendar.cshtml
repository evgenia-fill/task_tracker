@page
@model SMMTracker.WebUI.Pages.CalendarModel
@{
    ViewData["Title"] = "Календарь";
}

<div class="glass-card">
    <div id="calendar-container" data-calendarid="@Model.CurrentCalendarId" data-teamid="@Model.TeamId">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <button class="btn btn-outline-primary" onclick="changeMonth(-1)">
                <i class="bi bi-chevron-left"></i>
            </button>
            <h2 id="monthYearDisplay" class="mb-0 fw-bold text-primary">Загрузка...</h2>
            <button class="btn btn-outline-primary" onclick="changeMonth(1)">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>

        <div id="calendarGrid" class="calendar-grid">
            <div class="day-header">Пн</div>
            <div class="day-header">Вт</div>
            <div class="day-header">Ср</div>
            <div class="day-header">Чт</div>
            <div class="day-header">Пт</div>
            <div class="day-header">Сб</div>
            <div class="day-header">Вс</div>
        </div>
    </div>
    <div class="mt-4 pt-3 border-top text-center">
        <p class="text-muted style" style="font-style: italic; font-size: 1.1rem;">
            <i class="bi bi-info-circle me-1"></i>
            *данный раздел на данный момент находится в разработке :)
        </p>
    </div>
</div>

@section Scripts {
    <script>
        let state = {
            year: new Date().getFullYear(),
            month: new Date().getMonth(), // 0 = Январь
            calendarId: 0,
            teamId: 0
        };

        document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('calendar-container');
            if (container) {
                // Если атрибутов нет, ставим 0
                state.calendarId = parseInt(container.dataset.calendarid) || 0;
                state.teamId = parseInt(container.dataset.teamid) || 0;
            }
            renderCalendar();
        });

        function changeMonth(offset) {
            state.month += offset;
            if (state.month < 0) {
                state.month = 11;
                state.year--;
            } else if (state.month > 11) {
                state.month = 0;
                state.year++;
            }
            renderCalendar();
        }

        // --- ОБНОВЛЕННАЯ ФУНКЦИЯ ЗАГРУЗКИ ---
        async function fetchEvents(year, month) {
            // month приходит сюда от 1 до 12

            // 1. Формируем даты начала и конца месяца для API
            // Формат YYYY-MM-DD
            const startStr = `${year}-${String(month).padStart(2, '0')}-01`;
            
            // Вычисляем последний день месяца
            const lastDayDate = new Date(year, month, 0).getDate();
            const endStr = `${year}-${String(month).padStart(2, '0')}-${lastDayDate}`;

            try {
                // 2. Обращаемся к новому EventsController
                // URL: /api/events/calendar?start=...&end=...
                const response = await fetch(`/api/events/calendar?start=${startStr}&end=${endStr}`);
                
                if (response.ok) {
                    const data = await response.json();
                    
                    // 3. Маппинг данных
                    // API возвращает: { id, title, start }
                    // Рендер ждет:    { id, name, date }
                    return data.map(e => ({
                        id: e.id,
                        name: e.title,         // Берем title из API и кладем в name
                        date: new Date(e.start) // Превращаем строку ISO в объект Date
                    }));
                }
            } catch (error) {
                console.error("Ошибка загрузки событий:", error);
            }
            return []; 
        }

        async function renderCalendar() {
            const grid = document.getElementById('calendarGrid');
            const display = document.getElementById('monthYearDisplay');
            if (!grid || !display) return;

            const monthNames = ["Январь", "Февраль", "Март", "Апрель", "Май", "Июнь", "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь"];
            display.innerText = `${monthNames[state.month]} ${state.year}`;
            
            // Очистка старых ячеек (кроме заголовков дней недели)
            // Ищем элементы с классом .calendar-day и удаляем их
            const oldDays = grid.querySelectorAll('.calendar-day');
            oldDays.forEach(d => d.remove());

            const firstDay = new Date(state.year, state.month, 1);
            const lastDay = new Date(state.year, state.month + 1, 0);
            
            // Сдвиг дней недели (пн = 0 в верстке, но getDay() вс = 0)
            let startOffset = firstDay.getDay() - 1;
            if (startOffset === -1) startOffset = 6;

            // Загружаем события (передаем month + 1, т.к. API удобнее работать с 1-12)
            const events = await fetchEvents(state.year, state.month + 1);
            
            // Пустые ячейки до начала месяца
            for (let i = 0; i < startOffset; i++) {
                const empty = document.createElement('div');
                empty.className = 'calendar-day empty';
                grid.appendChild(empty);
            }
            
            // Ячейки с датами
            for (let d = 1; d <= lastDay.getDate(); d++) {
                const cell = document.createElement('div');
                cell.className = 'calendar-day';

                const num = document.createElement('div');
                num.className = 'date-number';
                num.innerText = d;
                cell.appendChild(num);
                
                const today = new Date();
                if (d === today.getDate() && state.month === today.getMonth() && state.year === today.getFullYear()) {
                    cell.classList.add('today');
                }
                
                // Фильтрация событий для текущего дня 'd'
                const dayEvents = events.filter(e =>
                    e.date.getDate() === d &&
                    e.date.getMonth() === state.month &&
                    e.date.getFullYear() === state.year
                );

                dayEvents.forEach(evt => {
                    const evDiv = document.createElement('div');
                    evDiv.className = 'event-item';
                    evDiv.innerText = evt.name || "Событие";
                    
                    // Клик по событию - переход на детали
                    // Используем evt.id, который пришел с бэкенда
                    evDiv.onclick = (e) => {
                        e.stopPropagation();
                        // Если teamId нужен в URL, берем из state
                        window.location.href = `/Event/${state.teamId}/${evt.id}`;
                    };
                    cell.appendChild(evDiv);
                });

                grid.appendChild(cell);
            }
        }
    </script>
}