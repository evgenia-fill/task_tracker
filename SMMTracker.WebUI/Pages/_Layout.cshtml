<!DOCTYPE html>
<html lang="ru">
<head>
    <environment include="Production">
    <!-- Yandex.Metrika counter -->
    <script type="text/javascript">
        (function(m,e,t,r,i,k,a){
            m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
            m[i].l=1*new Date();
            for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
            k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
        })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=106149554', 'ym');

        ym(106149554, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", accurateTrackBounce:true, trackLinks:true});
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/106149554" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <!-- /Yandex.Metrika counter -->
    </environment>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - SMM Tracker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .main-container {
            min-height: 100vh;
        }

        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            padding: 2rem;
        }

        .content-wrapper {
            padding-top: 20px;
        }
        
        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 1px;
            background-color: #dee2e6; /* Цвет сетки */
            border: 1px solid #dee2e6;
            border-radius: 8px;
            overflow: hidden;
        }

        .day-header {
            background-color: #f8f9fa;
            font-weight: bold;
            text-align: center;
            padding: 12px 5px;
            color: #495057;
            border-bottom: 1px solid #dee2e6;
        }

        .calendar-day {
            background-color: #ffffff;
            min-height: 110px;
            padding: 8px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            transition: background-color 0.2s;
        }

        .calendar-day:hover {
            background-color: #f8f9ff;
        }

        .calendar-day.today {
            background-color: #fff9db;
        }

        .date-number {
            font-size: 1rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 4px;
        }
        
        .event-item {
            display: block; 
            background-color: #667eea;
            color: white !important;
            font-size: 11px;
            padding: 4px 8px;
            border-radius: 4px;
            text-decoration: none !important;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            cursor: pointer;
            border-left: 3px solid #4a54e1;
            transition: all 0.2s;
        }
    </style>
</head>
<body>

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" asp-area="" asp-page="/Index">SMM Tracker</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Index">Главная</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Calendar">
                            <i class="bi bi-calendar3"></i> Календарь
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Dashboard">Дашборд</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Achievements">
                            <i class="bi bi-trophy"></i> Достижения
                        </a>
                    </li>

                    <div class="toast-container position-fixed bottom-0 end-0 p-3">
                    </div>

                    <script>
                        document.addEventListener("DOMContentLoaded", function() {
                            // Простая проверка новых ачивок при каждой загрузке страницы
                            fetch('/api/check-achievements') // Мы создадим этот мини-endpoint ниже
                                .then(response => response.json())
                                .then(achievements => {
                                    if (achievements && achievements.length > 0) {
                                        const container = document.querySelector('.toast-container');
                                        achievements.forEach(ach => {
                                            const html = `
                        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
                          <div class="toast-header bg-success text-white">
                            <i class="bi ${ach.iconClass} me-2"></i>
                            <strong class="me-auto">Новое достижение!</strong>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                          </div>
                          <div class="toast-body">
                            <strong>${ach.title}</strong><br>
                            ${ach.description}
                          </div>
                        </div>`;
                                            container.insertAdjacentHTML('beforeend', html);
                                        });
                                    }
                                })
                                .catch(err => console.log('No achievements check', err));
                        });
                    </script>
                </ul>
            </div>
        </div>
    </nav>
</header>

<div class="main-container gradient-bg">
    <main role="main" class="container content-wrapper">
        @RenderBody()
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Проверяем, есть ли в TempData сообщение о новой ачивке
        const newAchievement = '@(TempData["NewAchievement"])';

        if (newAchievement && newAchievement !== '') {
            Swal.fire({
                title: '🎉 Новое достижение!',
                text: 'Вы получили награду: ' + newAchievement,
                icon: 'success',
                confirmButtonText: 'Круто!',
                background: '#fff',
                backdrop: `rgba(0,0,123,0.4) url("https://sweetalert2.github.io/images/nyan-cat.gif") left center no-repeat`
            });
        }
    });
</script>
</body>
</html>